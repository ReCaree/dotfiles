layout {

    focus-ring {
        active-color   "#b6c8e1"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b6c8e1"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b6c8e1"
        inactive-color "#223347"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b6c8e180"
    }
}

recent-windows {
    highlight {
        active-color "#b6c8e1"
        urgent-color "#ffb4ab"
    }
}
