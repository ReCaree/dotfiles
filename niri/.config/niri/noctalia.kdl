layout {

    focus-ring {
        active-color   "#b5c8e3"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b5c8e3"
        inactive-color "#131315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b5c8e3"
        inactive-color "#3e5067"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b5c8e380"
    }
}

recent-windows {
    highlight {
        active-color "#b5c8e3"
        urgent-color "#ffb4ab"
    }
}
